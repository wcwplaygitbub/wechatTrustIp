# 企业微信应用 ID（逗号分隔）
WEWORK_APP_IDS=your_app_id_1,your_app_id_2

# 群机器人 Webhook Key
WEWORK_WEBHOOK_KEY=your_webhook_key

# IP 检测周期（cron 表达式，默认每 10 分钟）
IP_CHECK_CRON=*/10 * * * *

# Cookie 保活间隔（分钟，默认 20）
KEEP_ALIVE_INTERVAL_MINUTES=20

# Playwright 无头模式（默认 true）
HEADLESS=true

# 二维码扫码等待超时（秒，默认 120）
QR_TIMEOUT_SECONDS=120

# 服务端口（默认 8000）
PORT=8000

# 控制台登录用户名（默认 admin）
CONSOLE_USERNAME=admin
# 控制台登录密码（默认 admin123）
CONSOLE_PASSWORD=admin123
# 控制台访问地址（用于通知中的链接）
CONSOLE_URL=http://localhost:8000/console/
# 控制台认证密钥（默认使用 WEBHOOK_KEY，建议单独设置）
CONSOLE_SECRET_KEY=your_random_secret_key

# 日志文件单文件最大 MB（默认 100）
LOG_FILE_MAX_MB=100
# 日志文件保留备份数（默认 3）
LOG_FILE_BACKUP_COUNT=3